{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigation report",
  "type": "object",
  "required": ["notes", "assessments", "findings"],
  "additionalProperties": false,
  "properties": {
    "notes": {"type": "string", "minLength": 1},
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "outcome", "evidence"],
        "additionalProperties": false,
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["confirmed", "disproved", "already_fixed", "not_security", "inconclusive"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {"$ref": "../_shared/audit-findings.schema.json#/properties/findings"}
  },
  "if": {
    "properties": {
      "assessments": {"contains": {"properties": {"outcome": {"const": "confirmed"}}}}
    }
  },
  "then": {"properties": {"findings": {"minItems": 1}}},
  "else": {"properties": {"findings": {"maxItems": 0}}}
}
