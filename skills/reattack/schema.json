{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "patch re-attack report",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "variants", "benign_control", "notes"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["failed_to_bypass", "bypassed_patch", "inconclusive"]
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "origin", "valid", "outcome", "same_bug_class", "same_sink", "failure_class", "sink", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "enum": ["generated", "prior_bypass"] },
          "valid": { "type": "boolean" },
          "outcome": { "type": "string", "enum": ["blocked", "bypassed", "invalid"] },
          "same_bug_class": { "type": "boolean" },
          "same_sink": { "type": "boolean" },
          "failure_class": { "type": "string" },
          "sink": { "type": "string" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "benign_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "reached_sink", "crashed", "evidence"],
      "properties": {
        "input": { "type": "string" },
        "reached_sink": { "type": "boolean" },
        "crashed": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": "string" }
  }
}
